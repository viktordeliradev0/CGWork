@page "/register"
@using System.Net.Http.Headers
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JS

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            @if (isLoading)
            {
                <div class="alert alert-info text-center shadow-sm">Зареждане...</div>
            }
            else
            {
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-header bg-success text-white text-center py-4 rounded-top-4">
                        <i class="bi bi-person-plus-fill display-4"></i>
                        <h3 class="mt-2 mb-0 fw-bold">Добави нов учител</h3>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="fw-bold text-muted small">Име и Фамилия</label>
                            <input type="text" class="form-control" @bind="registerModel.FullName" placeholder="Напр. Иван Иванов" />
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold text-muted small">Телефонен номер</label>
                            <input type="tel" class="form-control" @bind="registerModel.PhoneNumber" placeholder="08..." />
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold text-muted small">Имейл адрес (за вход)</label>
                            <input type="email" class="form-control" @bind="registerModel.Email" placeholder="email@example.com" />
                        </div>

                        <div class="mb-4">
                            <label class="fw-bold text-muted small">Временна парола</label>
                            <input type="text" class="form-control" @bind="registerModel.Password" placeholder="Въведи сигурна парола" />
                            <small class="text-muted d-block mt-1"><i class="bi bi-info-circle"></i> Предайте тази парола на учителя.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Град / Клон на академията</label>
                            <select class="form-select" @bind="registerModel.City">
                                <option value="София">София</option>
                                <option value="Пловдив">Пловдив</option>
                                <option value="Варна">Варна</option>
                                <option value="Бургас">Бургас</option>
                                <!-- Добави останалите градове -->
                            </select>
                        </div>

                        <button class="btn btn-success w-100 fw-bold py-2 shadow-sm" @onclick="CreateUser">
                            <i class="bi bi-check-circle"></i> Създай профил
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool isLoading = true;
    private RegisterModel registerModel = new();

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrEmpty(token)) { NavigationManager.NavigateTo("/login"); return; }
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        try
        {
            var myProfile = await Http.GetFromJsonAsync<UserProfile>("api/Auth/me");
            // Ако не е мениджър, го изхвърляме на началния екран
            if (myProfile?.Role != "Мениджър")
            {
                NavigationManager.NavigateTo("/");
                return;
            }
        }
        catch { NavigationManager.NavigateTo("/login"); }

        isLoading = false;
    }

    private async Task CreateUser()
    {
        var response = await Http.PostAsJsonAsync("api/Auth/register", registerModel);

        if (response.IsSuccessStatusCode)
        {
            await JS.InvokeVoidAsync("alert", $"Успешно създадохте профил за {registerModel.FullName}!");
            // Изчистваме формата за евентуален следващ запис
            registerModel = new RegisterModel();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Грешка при създаване: {error}");
        }
    }

    public class UserProfile { public string Role { get; set; } = ""; }

    public class RegisterModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string FullName { get; set; } = "";
        public string City { get; set; } = "Пловдив";
        public string PhoneNumber { get; set; } = "";
        public string Role { get; set; } = "Teacher";
    }
}