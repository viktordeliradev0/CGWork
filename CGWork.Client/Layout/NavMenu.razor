<div class="cg-brand-header">
    <a class="navbar-brand fw-bold fs-4 text-orange m-0" href="">
        <i class="bi bi-code-slash me-2 text-orange"></i>CGWork
    </a>
    <button title="Navigation menu" class="navbar-toggler border-0 d-md-none" @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>

<div class="@NavMenuCssClass cg-nav-list" @onclick="ToggleNavMenu">
    <nav class="flex-column p-2">
        <div class="nav-item mb-1">
            <NavLink class="nav-link rounded-3 px-3 py-2" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill me-2"></i> Начало
            </NavLink>
        </div>
        <div class="nav-item mb-1">
            <NavLink class="nav-link rounded-3 px-3 py-2" href="groups">
                <i class="bi bi-collection-fill me-2"></i> Групи
            </NavLink>
        </div>
        <div class="nav-item mb-1">
            <NavLink class="nav-link rounded-3 px-3 py-2" href="students">
                <i class="bi bi-person-badge-fill me-2"></i> Ученици
            </NavLink>
        </div>
        <div class="nav-item mb-1">
            <NavLink class="nav-link rounded-3 px-3 py-2" href="lessons">
                <i class="bi bi-journal-check me-2"></i> Уроци
            </NavLink>
        </div>
        <div class="nav-item mb-1">
            <NavLink class="nav-link rounded-3 px-3 py-2" href="teachers">
                <i class="bi bi-people-fill me-2"></i> Учители
            </NavLink>
        </div>
        <div class="nav-item mb-1">
            <NavLink class="nav-link rounded-3 px-3 py-2" href="my-profile">
                <i class="bi bi-person-vcard-fill me-2"></i> Моят Профил
            </NavLink>
        </div>

        <hr class="my-2 text-muted opacity-25" />

        <div class="nav-item mb-1">
            <NavLink class="nav-link rounded-3 text-orange fw-bold px-3 py-2" href="register">
                <i class="bi bi-person-plus-fill me-2"></i> Добави учител
            </NavLink>
        </div>
        <div class="nav-item mb-1">
            <NavLink class="nav-link rounded-3 px-3 py-2" href="login">
                <i class="bi bi-box-arrow-in-right me-2"></i> Вход
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}