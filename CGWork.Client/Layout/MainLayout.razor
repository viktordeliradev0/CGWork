@inherits LayoutComponentBase

<div class="cg-layout-single">
    <!-- ГОРНА ЛЕНТА (HEADER) -->
    <header class="cg-top-header border-bottom shadow-sm bg-white px-4 d-flex justify-content-between align-items-center">
        <a href="/" class="navbar-brand fw-bold fs-4 text-orange m-0">
            <i class="bi bi-code-slash me-2 text-orange"></i>CGWork
        </a>

        <div class="d-flex align-items-center">
            <a href="/my-profile" class="btn btn-sm btn-outline-orange me-2">
                <i class="bi bi-person-vcard-fill me-1"></i> Профил
            </a>
            <a href="/login" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-box-arrow-right me-1"></i> Изход
            </a>
        </div>
    </header>

    <!-- ОСНОВНО СЪДЪРЖАНИЕ -->
    <main class="cg-page-body p-4">
        <article class="container-fluid max-width-xl">
            @Body
        </article>
    </main>
</div>